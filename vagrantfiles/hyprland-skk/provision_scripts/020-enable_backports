#!/bin/bash

set -eux -o pipefail

# Hyprland is not in trixie itself, only in trixie-backports. Debian 13 reads
# deb822 sources, so this is a .sources file rather than a line in
# /etc/apt/sources.list.
sudo tee /etc/apt/sources.list.d/debian-backports.sources > /dev/null <<'SOURCES'
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie-backports
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
SOURCES

# Backports normally sits at priority 100, so it is only used when asked for by
# name with "apt-get -t trixie-backports". That does not work here.
#
# Hyprland drags a good part of the graphics stack up with it -- mesa,
# libxkbcommon, wayland -- and every later install that touches the same
# libraries then has to be asked for from backports too, or apt tries to
# satisfy it from trixie and collides with what is already on disk:
#
#   libxkbcommon-dev : Depends: libxkbcommon0 (= 1.7.0-2)
#                      but 1.13.1-1~bpo13+1 is to be installed
#   E: Unable to correct problems, you have held broken packages.
#
# Missing one -t is easy and the failure comes much later, in an unrelated
# script. Raising backports to the same priority as trixie lets apt pick the
# newest version of anything, consistently, and the -t flags disappear.
sudo tee /etc/apt/preferences.d/trixie-backports > /dev/null <<'PREFERENCES'
Package: *
Pin: release n=trixie-backports
Pin-Priority: 500
PREFERENCES

sudo apt-get update

apt-cache policy hyprland
