#!/bin/bash

set -eux -o pipefail

# The GTK and Qt IM modules (fcitx5-frontend-gtk4 and friends) are deliberately
# not installed. Everything here talks Wayland, where fcitx5's own frontend
# implements text-input-v3 and the applications reach it through the compositor
# rather than through a loadable module. See docs/010-design.md, section 6.
sudo apt-get install -y --no-install-recommends \
  fcitx5 \
  fcitx5-skk \
  fcitx5-config-qt \
  skkdic

# Writing the profile here avoids the first-run dance of adding an input method
# by hand. Group 0 holds the US keyboard and SKK, in that order, so the trigger
# key below toggles between them and a fresh session starts in Latin.
mkdir -p ~/.config/fcitx5/conf
cat > ~/.config/fcitx5/profile <<'PROFILE'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=skk
Layout=

[GroupOrder]
0=Default
PROFILE

# Shift+Space replaces fcitx5's default trigger keys (Ctrl+Space and
# Zenkaku_Hankaku) rather than adding to them. Anything left out of this file
# keeps its default.
#
# TogglePreedit is emptied: its default, Ctrl+Alt+P, is taken by fcitx5 before
# any input method sees it -- even with the US keyboard active -- so Emacs never
# gets C-M-p. The section header alone, with no keys under it, is what makes
# the list empty; leaving the section out would bring the default back.
cat > ~/.config/fcitx5/config <<'CONFIG'
[Hotkey/TriggerKeys]
0=Shift+space

[Hotkey/TogglePreedit]
CONFIG

# The symbols follow the skk-rom-kana-rule-list that 050 gives DDSKK: "@", "!",
# "~", "(" and ")" turn full-width, z plus a symbol gives the ASCII one, and
# "z," and "z." give "、" and "。" now that the plain keys give "，" and "．".
# libskk takes such changes as a rule of its own, found under
# ~/.config/libskk/rules. Including default/default and overriding only these
# keys leaves the rest of the standard rule alone, and with no keymap/ directory
# the standard keymaps are used. "hh" and "mm" are not repeated: libskk's
# standard rule already turns them into "っ".
mkdir -p ~/.config/libskk/rules/my-default/rom-kana
cat > ~/.config/libskk/rules/my-default/metadata.json <<'METADATA_JSON'
{
    "name": "Default (customized)",
    "description": "Default typing rule with symbols matched to DDSKK"
}
METADATA_JSON
cat > ~/.config/libskk/rules/my-default/rom-kana/default.json <<'ROM_KANA_JSON'
{
    "include": [
        "default/default"
    ],
    "define": {
        "rom-kana": {
            "@": ["", "＠"],
            ":": ["", "："],
            ";": ["", "；"],
            "?": ["", "？"],
            "!": ["", "！"],
            "~": ["", "〜"],
            "z@": ["", "@"],
            "z:": ["", ":"],
            "z;": ["", ";"],
            "z?": ["", "?"],
            "z!": ["", "!"],
            "z,": ["", "、"],
            "z.": ["", "。"],
            "(": ["", "（"],
            ")": ["", "）"]
        }
    }
}
ROM_KANA_JSON

# Romaji to kana needs no dictionary at all; the dictionary only comes into it
# for kanji conversion, and fcitx5-skk finds skkdic's SKK-JISYO.L on its own.
# What is stated is the mode SKK starts in, the punctuation and the rule above.
#
# PunctuationStyle=Latin is the full-width "．" and "，", not ASCII: the names
# come from libskk's EN_EN, and "Wide latin" is in fact "。" with "，". This
# matches DDSKK's skk-kutouten-type 'en in 050.
cat > ~/.config/fcitx5/conf/skk.conf <<'SKK_CONF'
InitialInputMode=Hiragana
PunctuationStyle=Latin
Rule=my-default
SKK_CONF
