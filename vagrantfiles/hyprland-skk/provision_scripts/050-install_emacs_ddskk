#!/bin/bash

set -eux -o pipefail

# emacs-pgtk rather than emacs-gtk: the pure GTK build talks Wayland natively
# instead of going through XWayland.
#
# Emacs does its own Japanese input with DDSKK and does not use fcitx5 at all;
# running both would convert twice.
sudo apt-get install -y --no-install-recommends \
  emacs-pgtk \
  ddskk

mkdir -p ~/.emacs.d
cat > ~/.emacs.d/init.el <<'INIT_EL'
;; DDSKK. C-x C-j turns it on; skkdic provides the large dictionary.
(setq default-input-method "japanese-skk")
(setq skk-large-jisyo "/usr/share/skk/SKK-JISYO.L")
(global-set-key (kbd "C-x C-j") 'skk-mode)
INIT_EL

# The menu entry starts a client and, with -a "", a daemon on first use, so it
# works whether or not the user unit below is running.
mkdir -p ~/.local/share/applications
cat > ~/.local/share/applications/emacsclient.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Emacs Client
Comment=Edit with an Emacs client
Exec=emacsclient -c -a "" %F
Icon=emacs
Terminal=false
Categories=Development;TextEditor;
DESKTOP

# Debian ships a user unit with emacs-common. Enable it when it is there so
# that the daemon is already up at login and the first client is instant.
if systemctl --user list-unit-files emacs.service > /dev/null 2>&1
then
  systemctl --user enable emacs.service || true
fi
