#!/bin/bash

set -eux -o pipefail

mkdir -p ~/.config/hypr

# Hyprland 0.55 reads hyprland.lua in preference to hyprland.conf, so an old
# hyprland.conf would be ignored anyway. It goes so that nobody edits it
# expecting an effect.
rm -f ~/.config/hypr/hyprland.conf

cat > ~/.config/hypr/hyprland.lua <<'HYPRLAND_LUA'
-- The monitor is left unnamed so that this matches whatever the virtio GPU
-- calls its connector. 1920x1080 is asked for explicitly rather than taking
-- "preferred", because virtio-gpu passes any mode through to the host.
hl.monitor({
  output   = "",
  mode     = "1920x1080@60",
  position = "0x0",
  scale    = "1",
})

-- Japanese input.
--
-- GTK_IM_MODULE and QT_IM_MODULE are deliberately absent: with neither set, GTK
-- and Qt use their built-in Wayland input method and reach fcitx5 over
-- text-input-v3. XMODIFIERS only matters to XWayland clients, of which there
-- are none here, but it costs nothing.
hl.env("XMODIFIERS", "@im=fcitx")

-- There is no virgl in this VM, so Mesa renders on the CPU with llvmpipe.
hl.env("LIBGL_ALWAYS_SOFTWARE", "1")

-- hyprland.start fires once per session, as exec-once did. A bare
-- hl.exec_cmd() at the top level would run again on every reload.
hl.on("hyprland.start", function()
  hl.exec_cmd("fcitx5 -d")
  hl.exec_cmd("waybar")
end)

-- Hyprland's modifier masks come from X11 and do not tell the two Alt keys
-- apart: both are ALT. The right one is turned into ISO_Level3_Shift by
-- kb_options below, which gives it a mask of its own -- MOD5 -- while the left
-- Alt keeps ALT.
local mainMod = "MOD5"

hl.bind(mainMod .. " + Q",     hl.dsp.exec_cmd("/usr/local/bin/ghostty"))
hl.bind(mainMod .. " + R",     hl.dsp.exec_cmd("wofi --show drun"))
hl.bind(mainMod .. " + C",     hl.dsp.window.close())
hl.bind(mainMod .. " + M",     hl.dsp.exit())
hl.bind(mainMod .. " + V",     hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down" }))

hl.config({
  input = {
    kb_layout = "us",
    -- Right Alt becomes ISO_Level3_Shift, so that mainMod above has a
    -- modifier to bind to. The us layout defines no third level, so
    -- nothing types differently because of it.
    kb_options   = "lv3:ralt_switch",
    follow_mouse = 1,
  },

  -- Everything is drawn on the CPU, so the expensive effects are off.
  animations = {
    enabled = false,
  },

  decoration = {
    rounding = 0,
    blur = {
      enabled = false,
    },
    shadow = {
      enabled = false,
    },
  },

  -- No vfr here: Hyprland 0.55 does not have that option any more, and an
  -- unknown key is a startup error banner across the top of the screen.
  misc = {
    disable_hyprland_logo    = true,
    disable_splash_rendering = true,
  },
})
HYPRLAND_LUA
